{% if page.name == 'about.md' and page.animated_background %}
  <script src="https://cdn.jsdelivr.net/npm/@tsparticles/engine@4/tsparticles.engine.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tsparticles/slim@4/tsparticles.slim.bundle.min.js"></script>
  <script defer type="text/javascript">
    (function () {
      var starContainer = null;
      var meteorCanvas,
        meteorCtx,
        meteorRAF = null;
      var meteor = null;
      var meteorTimeout = null;
      var meteorLastTime = null;

      // Custom mouse-attraction loop, driven directly via the public tsParticles
      // Particle API (position/velocity) rather than tsParticles' own built-in
      // interactivity plugin, so it has no dependency on that plugin's internals.
      var mouseX = null;
      var mouseY = null;
      var markerX = null;
      var markerY = null;
      // The star layer is visually shifted by the parallax transform below;
      // the attraction math has to compensate for that shift, or the "pull
      // point" drifts away from the actual visible cursor position.
      var parallaxOffsetX = 0;
      var parallaxOffsetY = 0;
      var attractRAF = null;
      var attractLastTime = null;
      var ATTRACT_RADIUS = 165; // a bit larger than the tight 110 test, still well short of the original 260 that felt like the whole screen moving
      var ATTRACT_STRENGTH = 0.32; // radial pull dominates now, so stars actually converge near the cursor
      var ORBIT_STRENGTH = 0.13; // tangential -- just enough to curve the approach, not sweep stars into wide arcs
      var MAX_SPEED = 3.2; // low enough that captured stars can't reach "escape velocity" and slingshot away permanently
      var EVENT_HORIZON_RADIUS = 26; // stars crossing this close are consumed -- a real point of no return, not just a strong pull
      // The black hole *marker* (visual glow) only settles in once the
      // cursor stops moving -- the gravity pull on stars stays active the
      // whole time regardless, only the visible circle is gated by this.
      var idleAmount = 0;
      var idleCheckX = null;
      var idleCheckY = null;
      var idleStillSince = null;
      var IDLE_DELAY_MS = 2000; // cursor has to be genuinely still this long before the marker starts to appear -- otherwise it looks like it's being dragged around

      // Target a 60fps baseline: dt=1 means "this frame arrived exactly
      // 1/60s after the last one". A 120Hz display fires callbacks twice as
      // often, so each dt is ~0.5 -- multiplying every increment by dt keeps
      // real-world speed (px/sec, force/sec) the same regardless of the
      // viewer's refresh rate. Capped so a backgrounded/suspended tab
      // regaining focus doesn't apply one giant catch-up jump.
      function applyAttractionFrame(timestamp) {
        var dt = 1;
        if (attractLastTime !== null) {
          dt = Math.min(Math.max((timestamp - attractLastTime) / (1000 / 60), 0), 4);
        }
        attractLastTime = timestamp;

        if (mouseX !== null) {
          var cursorMoved = idleCheckX === null || Math.abs(mouseX - idleCheckX) > 0.5 || Math.abs(mouseY - idleCheckY) > 0.5;
          if (cursorMoved) {
            idleAmount = Math.max(0, idleAmount - 0.18 * dt);
            idleStillSince = null;
          } else {
            if (idleStillSince === null) {
              idleStillSince = timestamp;
            }
            if (timestamp - idleStillSince > IDLE_DELAY_MS) {
              idleAmount = Math.min(1, idleAmount + 0.035 * dt);
            }
          }
          idleCheckX = mouseX;
          idleCheckY = mouseY;
        }

        if (starContainer && mouseX !== null) {
          // Particle positions are in device pixels (detectRetina: true) and
          // don't know about the parallax transform applied to their
          // container div, so back that shift out of the mouse position
          // before converting to device pixels -- otherwise the "pull
          // point" drifts away from where the cursor actually is on screen.
          var ratio = (starContainer.retina && starContainer.retina.pixelRatio) || 1;
          var mx = (mouseX - parallaxOffsetX) * ratio;
          var my = (mouseY - parallaxOffsetY) * ratio;
          var radius = ATTRACT_RADIUS * ratio;

          // The black hole marker: a small dark circle with a dull orange glow,
          // positioned near the cursor and only shown once it's settled
          // (idleAmount) -- not while actively moving. It eases toward the
          // cursor rather than snapping to it -- something with real mass
          // wouldn't teleport around the screen.
          if (markerX === null) {
            markerX = mouseX;
            markerY = mouseY;
          } else {
            var markerEase = 1 - Math.pow(1 - 0.06, dt);
            markerX += (mouseX - markerX) * markerEase;
            markerY += (mouseY - markerY) * markerEase;
          }

          if (meteorCtx && idleAmount > 0.01) {
            var markerR = 5;
            var glowR = 18;
            meteorCtx.save();
            var glow = meteorCtx.createRadialGradient(markerX, markerY, markerR, markerX, markerY, glowR);
            glow.addColorStop(0, 'rgba(200, 130, 60, ' + (idleAmount * 0.35).toFixed(2) + ')');
            glow.addColorStop(1, 'rgba(200, 130, 60, 0)');
            meteorCtx.beginPath();
            meteorCtx.fillStyle = glow;
            meteorCtx.arc(markerX, markerY, glowR, 0, 2 * Math.PI);
            meteorCtx.fill();

            meteorCtx.beginPath();
            meteorCtx.fillStyle = 'rgba(4, 4, 6, ' + (idleAmount * 0.9).toFixed(2) + ')';
            meteorCtx.arc(markerX, markerY, markerR, 0, 2 * Math.PI);
            meteorCtx.fill();
            meteorCtx.restore();
          }

          var count = starContainer.particles.count;
          for (var i = 0; i < count; i++) {
            var p = starContainer.particles.get(i);
            if (!p) continue;

            if (p.__baseSize === undefined) {
              p.__baseSize = p.size.value;
              p.__baseOpacity = p.opacity ? p.opacity.value : 1;
              p.__baseSpeed = Math.sqrt(p.velocity.x * p.velocity.x + p.velocity.y * p.velocity.y);
              p.__baseOpacityVelocity = p.opacity ? p.opacity.velocity : undefined;
            }

            var dx = mx - p.position.x;
            var dy = my - p.position.y;
            var dist = Math.sqrt(dx * dx + dy * dy);

            var factor = dist < radius ? (radius - dist) / radius : 0;

            // Brighten & enlarge stars near the cursor, so the effect reads
            // instantly rather than relying only on the (subtler) motion.
            p.size.value = p.__baseSize * (1 + factor * 3);
            if (p.opacity) {
              p.opacity.value = Math.min(1, p.__baseOpacity + factor * 0.9);
            }

            // What actually happens at a real event horizon, from our
            // (outside observer's) point of view: nothing ever visibly
            // crosses it. Infalling matter asymptotically slows, dims, and
            // redshifts forever, getting arbitrarily close but never
            // observed to actually reach the boundary. So instead of
            // deleting a star at a hard cutoff, its inward motion gets
            // damped and it fades out the closer it gets -- it only quietly
            // recycles once it's already imperceptible, which looks
            // identical to "faded to nothing" rather than "vanished".
            var horizonZone = EVENT_HORIZON_RADIUS * 2.5 * ratio;
            if (dist < horizonZone) {
              var freeze = 1 - (dist - EVENT_HORIZON_RADIUS * ratio) / (horizonZone - EVENT_HORIZON_RADIUS * ratio);
              freeze = Math.min(1, Math.max(0, freeze));

              var radialUnitX = dx / dist;
              var radialUnitY = dy / dist;
              var velRadial = p.velocity.x * radialUnitX + p.velocity.y * radialUnitY;
              if (velRadial > 0) {
                var radialDamp = Math.pow(1 - freeze, 3);
                var velRadialDelta = velRadial * radialDamp - velRadial;
                p.velocity.x += radialUnitX * velRadialDelta;
                p.velocity.y += radialUnitY * velRadialDelta;
              }

              p.size.value *= 1 - freeze * 0.6;
              if (p.opacity) {
                p.opacity.value *= 1 - freeze * 0.97;
                if (freeze > 0.9 && p.opacity.value < 0.02) {
                  starContainer.particles.remove(p);
                  starContainer.particles.push(1);
                  continue;
                }
              }
            }

            // Time dilation: real gravity slows time nearby, so slow each
            // star's own twinkle animation the closer it is to the cursor
            // (tsParticles exposes the animation's own rate as .velocity).
            if (p.opacity && p.__baseOpacityVelocity !== undefined) {
              p.opacity.velocity = p.__baseOpacityVelocity * (1 - factor * 0.85);
            }

            if (factor > 0) {
              // Radial pull toward the cursor (gravity) plus a tangential
              // push perpendicular to it (orbital motion) -- together they
              // make stars curve and swirl around the cursor like orbiting
              // a compact gravity well, rather than flying straight into it.
              var radialForce = factor * ATTRACT_STRENGTH;
              var orbitForce = factor * ORBIT_STRENGTH;
              var radialX = dx / dist;
              var radialY = dy / dist;
              var tangentX = -radialY;
              var tangentY = radialX;

              p.velocity.x += (radialX * radialForce + tangentX * orbitForce) * dt;
              p.velocity.y += (radialY * radialForce + tangentY * orbitForce) * dt;

              var speed = Math.sqrt(p.velocity.x * p.velocity.x + p.velocity.y * p.velocity.y);
              if (speed > MAX_SPEED) {
                p.velocity.x = (p.velocity.x / speed) * MAX_SPEED;
                p.velocity.y = (p.velocity.y / speed) * MAX_SPEED;
              }

              var sx = p.position.x / ratio;
              var sy = p.position.y / ratio;

              // Tidal stretching ("spaghettification"): the closer a star
              // gets, the more it visually stretches along the line toward
              // the cursor -- real effect of strong nearby gravity.
              if (factor > 0.5) {
                var stretchAmt = (factor - 0.5) * 2;
                var stretchLen = stretchAmt * 16;
                var tailX = sx - radialX * stretchLen;
                var tailY = sy - radialY * stretchLen;
                var headX = sx + radialX * stretchLen * 0.3;
                var headY = sy + radialY * stretchLen * 0.3;

                var stretchGrad = meteorCtx.createLinearGradient(headX, headY, tailX, tailY);
                stretchGrad.addColorStop(0, 'rgba(255, 255, 255, ' + (0.15 + stretchAmt * 0.5).toFixed(2) + ')');
                stretchGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

                meteorCtx.strokeStyle = stretchGrad;
                meteorCtx.lineWidth = Math.max(0.6, p.__baseSize * 0.5);
                meteorCtx.beginPath();
                meteorCtx.moveTo(headX, headY);
                meteorCtx.lineTo(tailX, tailY);
                meteorCtx.stroke();
              }

              // Accretion heating: matter compresses and heats up as it
              // nears a black hole, shifting from white toward hot blue-white
              // the closer it gets (real accretion disks are visibly bluer
              // and hotter near the center, cooler/redder further out).
              if (factor > 0.15) {
                var heat = (factor - 0.15) / 0.85;
                var glowR = p.__baseSize * 3.5 + 2;

                meteorCtx.beginPath();
                meteorCtx.fillStyle = 'rgba(140, 190, 255, ' + (heat * 0.55).toFixed(2) + ')';
                meteorCtx.arc(sx, sy, glowR, 0, 2 * Math.PI);
                meteorCtx.fill();
              }
            } else {
              // Once a star leaves the interaction zone, nothing was
              // bringing its velocity back down -- it would just keep
              // drifting off at whatever speed it picked up, even long
              // after the cursor moved away. Damp it back toward its
              // natural ambient speed instead.
              var curSpeed = Math.sqrt(p.velocity.x * p.velocity.x + p.velocity.y * p.velocity.y);
              if (curSpeed > p.__baseSpeed * 1.2) {
                var damping = Math.pow(0.82, dt);
                p.velocity.x *= damping;
                p.velocity.y *= damping;
              }
            }
          }
        }

        attractRAF = requestAnimationFrame(applyAttractionFrame);
      }

      function startAttract() {
        if (attractRAF) return;
        attractLastTime = null; // avoid one huge dt jump on (re)start
        attractRAF = requestAnimationFrame(applyAttractionFrame);
      }

      // Split the star field into three depth layers (far/mid/near) so it
      // reads as a starfield with real depth instead of a flat scatter of
      // uniform dots -- distant stars are smaller, dimmer and drift slower;
      // near stars are bigger, brighter and drift faster.
      function applyDepthLayers(container) {
        var count = container.particles.count;
        for (var i = 0; i < count; i++) {
          var p = container.particles.get(i);
          if (!p) continue;

          var roll = Math.random();
          var size, opacity, speedFactor;

          if (roll < 0.55) {
            // far
            size = 0.3 + Math.random() * 0.3;
            opacity = 0.15 + Math.random() * 0.25;
            speedFactor = 0.5;
          } else if (roll < 0.85) {
            // mid
            size = 0.6 + Math.random() * 0.5;
            opacity = 0.35 + Math.random() * 0.35;
            speedFactor = 1;
          } else {
            // near
            size = 1.1 + Math.random() * 0.7;
            opacity = 0.6 + Math.random() * 0.4;
            speedFactor = 1.7;
          }

          p.size.value = size;
          if (p.opacity) p.opacity.value = opacity;
          p.velocity.x *= speedFactor;
          p.velocity.y *= speedFactor;
        }
      }

      function stopAttract() {
        if (attractRAF) {
          cancelAnimationFrame(attractRAF);
          attractRAF = null;
        }
      }

      function resizeMeteorCanvas() {
        meteorCanvas.width = window.innerWidth;
        meteorCanvas.height = window.innerHeight;
      }

      function spawnMeteor() {
        // A tumbling rock, not a "shooting star" -- in real vacuum there's
        // no atmosphere to create a glowing trail, so no tail here. It's
        // mostly dim/near-invisible, occasionally catching a brief glint of
        // starlight as it slowly tumbles, drifting at a modest pace rather
        // than streaking dramatically.
        var angle = ((20 + Math.random() * 50) * Math.PI) / 180;
        var speed = 0.5 + Math.random() * 0.5;
        meteor = {
          x: Math.random() * window.innerWidth * 0.6,
          y: -30 - Math.random() * 80,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          headRadius: 2.2 + Math.random() * 1.6,
          glintPhase: Math.random() * Math.PI * 2,
          glintSpeed: 0.02 + Math.random() * 0.03,
        };
      }

      function drawMeteorFrame(timestamp) {
        var dt = 1;
        if (meteorLastTime !== null) {
          dt = Math.min(Math.max((timestamp - meteorLastTime) / (1000 / 60), 0), 4);
        }
        meteorLastTime = timestamp;

        meteorCtx.clearRect(0, 0, meteorCanvas.width, meteorCanvas.height);

        if (meteor && mouseX !== null) {
          // The black hole deflects (or consumes) the meteor too, same
          // physics as the stars -- a real black hole bends the path of
          // anything passing close, meteors included.
          var mdx = mouseX - meteor.x;
          var mdy = mouseY - meteor.y;
          var mdist = Math.sqrt(mdx * mdx + mdy * mdy);

          if (mdist < ATTRACT_RADIUS) {
            var mFactor = (ATTRACT_RADIUS - mdist) / ATTRACT_RADIUS;
            var mRadialX = mdx / mdist;
            var mRadialY = mdy / mdist;
            var mTangentX = -mRadialY;
            var mTangentY = mRadialX;

            meteor.vx += (mRadialX * mFactor * ATTRACT_STRENGTH + mTangentX * mFactor * ORBIT_STRENGTH) * dt;
            meteor.vy += (mRadialY * mFactor * ATTRACT_STRENGTH + mTangentY * mFactor * ORBIT_STRENGTH) * dt;
          }

          // Same "never actually crosses" behavior as the stars: damp the
          // inward motion and fade it out rather than deleting it at a
          // hard cutoff, so it asymptotically freezes near the horizon
          // instead of visibly popping out of existence.
          var mHorizonZone = EVENT_HORIZON_RADIUS * 2.5;
          meteor.freeze = 0;
          if (mdist < mHorizonZone) {
            meteor.freeze = Math.min(1, Math.max(0, 1 - (mdist - EVENT_HORIZON_RADIUS) / (mHorizonZone - EVENT_HORIZON_RADIUS)));

            var mRadialUnitX = mdx / mdist;
            var mRadialUnitY = mdy / mdist;
            var mVelRadial = meteor.vx * mRadialUnitX + meteor.vy * mRadialUnitY;
            if (mVelRadial > 0) {
              var mRadialDamp = Math.pow(1 - meteor.freeze, 3);
              var mVelRadialDelta = mVelRadial * mRadialDamp - mVelRadial;
              meteor.vx += mRadialUnitX * mVelRadialDelta;
              meteor.vy += mRadialUnitY * mVelRadialDelta;
            }

            if (meteor.freeze > 0.985) {
              meteor = null;
              meteorTimeout = setTimeout(
                function () {
                  meteorTimeout = null;
                  spawnMeteor();
                },
                6000 + Math.random() * 9000
              );
            }
          }
        }

        if (meteor) {
          // Mostly dim (barely lit by distant starlight), with an occasional
          // brief glint as it slowly tumbles and catches the light at a
          // reflective angle -- no glow, no tail.
          meteor.glintPhase += meteor.glintSpeed * dt;
          var glint = Math.max(0, Math.sin(meteor.glintPhase));
          var brightness = (0.12 + Math.pow(glint, 6) * 0.85) * (1 - (meteor.freeze || 0) * 0.97);

          meteorCtx.beginPath();
          meteorCtx.fillStyle = 'rgba(200, 205, 215, ' + brightness.toFixed(2) + ')';
          meteorCtx.arc(meteor.x, meteor.y, meteor.headRadius, 0, 2 * Math.PI);
          meteorCtx.fill();

          meteor.x += meteor.vx * dt;
          meteor.y += meteor.vy * dt;

          if (meteor.x - meteor.headRadius > meteorCanvas.width || meteor.y - meteor.headRadius > meteorCanvas.height) {
            meteor = null;
            meteorTimeout = setTimeout(
              function () {
                meteorTimeout = null;
                spawnMeteor();
              },
              6000 + Math.random() * 9000
            );
          }
        }

        meteorRAF = requestAnimationFrame(drawMeteorFrame);
      }

      function startMeteor() {
        if (meteorRAF) return;
        if (!meteor && !meteorTimeout) {
          meteorTimeout = setTimeout(
            function () {
              meteorTimeout = null;
              spawnMeteor();
            },
            500 + Math.random() * 4000
          );
        }
        meteorLastTime = null; // avoid one huge dt jump on (re)start
        meteorRAF = requestAnimationFrame(drawMeteorFrame);
      }

      function stopMeteor() {
        if (meteorRAF) {
          cancelAnimationFrame(meteorRAF);
          meteorRAF = null;
        }
        if (meteorTimeout) {
          clearTimeout(meteorTimeout);
          meteorTimeout = null;
        }
        meteorCtx.clearRect(0, 0, meteorCanvas.width, meteorCanvas.height);
      }

      // Nebula color/position is randomized per page load, picked from a
      // curated palette + a set of corner slots so it always looks tasteful
      // rather than truly arbitrary.
      var NEBULA_PALETTE = [
        { r: 45, g: 170, b: 165 }, // teal
        { r: 190, g: 60, b: 120 }, // rose / magenta
        { r: 120, g: 90, b: 200 }, // purple
        { r: 60, g: 110, b: 200 }, // blue
        { r: 200, g: 140, b: 60 }, // amber
        { r: 90, g: 180, b: 120 }, // green
      ];
      var NEBULA_CORNERS = [
        { top: true, left: true },
        { top: true, left: false },
        { top: false, left: true },
        { top: false, left: false },
      ];

      function shuffled(arr) {
        var a = arr.slice();
        for (var i = a.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = a[i];
          a[i] = a[j];
          a[j] = tmp;
        }
        return a;
      }

      function randomizeNebula() {
        var colors = shuffled(NEBULA_PALETTE).slice(0, 2);
        var corners = shuffled(NEBULA_CORNERS).slice(0, 2);
        var maxOpacity = [0.1, 0.09];
        var els = [document.getElementById('nebula-one'), document.getElementById('nebula-two')];

        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (!el) continue;

          var c = colors[i];
          el.style.background =
            'radial-gradient(circle at 50% 50%, rgba(' +
            c.r +
            ', ' +
            c.g +
            ', ' +
            c.b +
            ', ' +
            maxOpacity[i] +
            ') 0%, rgba(' +
            c.r +
            ', ' +
            c.g +
            ', ' +
            c.b +
            ', 0) 70%)';

          var corner = corners[i];
          var vOffset = (5 + Math.random() * 14).toFixed(1) + '%';
          var hOffset = (5 + Math.random() * 14).toFixed(1) + '%';
          el.style.top = corner.top ? vOffset : '';
          el.style.bottom = corner.top ? '' : vOffset;
          el.style.left = corner.left ? hOffset : '';
          el.style.right = corner.left ? '' : hOffset;
        }
      }

      function applyBackgroundTheme(theme) {
        var starsEl = document.getElementById('tsparticles-stars');
        var sunEl = document.getElementById('sun-glow');
        var nebulaOne = document.getElementById('nebula-one');
        var nebulaTwo = document.getElementById('nebula-two');

        if (theme === 'light') {
          if (starsEl) starsEl.style.opacity = 0;
          if (meteorCanvas) meteorCanvas.style.opacity = 0;
          if (sunEl) sunEl.style.opacity = 1;
          if (nebulaOne) nebulaOne.style.opacity = 0;
          if (nebulaTwo) nebulaTwo.style.opacity = 0;
          if (starContainer) starContainer.pause();
          stopMeteor();
          stopAttract();
        } else {
          if (starsEl) starsEl.style.opacity = 1;
          if (meteorCanvas) meteorCanvas.style.opacity = 1;
          if (sunEl) sunEl.style.opacity = 0;
          if (nebulaOne) nebulaOne.style.opacity = 1;
          if (nebulaTwo) nebulaTwo.style.opacity = 1;
          if (starContainer) starContainer.play();
          startMeteor();
          startAttract();
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        randomizeNebula();

        meteorCanvas = document.getElementById('meteor-canvas');
        meteorCtx = meteorCanvas.getContext('2d');
        resizeMeteorCanvas();
        window.addEventListener('resize', resizeMeteorCanvas);

        var starsEl = document.getElementById('tsparticles-stars');
        var PARALLAX_STRENGTH = 0; // max px shift -- 0 disables the parallax tilt (local test)

        window.addEventListener('mousemove', function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;

          // Cursor parallax tilt: the star layer shifts a few px opposite the
          // cursor, independent of the per-star attraction effect, so there's
          // a constant subtle depth cue even when not hovering near any star.
          parallaxOffsetX = (e.clientX / window.innerWidth - 0.5) * -2 * PARALLAX_STRENGTH;
          parallaxOffsetY = (e.clientY / window.innerHeight - 0.5) * -2 * PARALLAX_STRENGTH;
          var transform = 'translate(' + parallaxOffsetX.toFixed(1) + 'px, ' + parallaxOffsetY.toFixed(1) + 'px)';
          if (starsEl) starsEl.style.transform = transform;
          if (meteorCanvas) meteorCanvas.style.transform = transform;
        });

        loadSlim(tsParticles).then(function () {
          return tsParticles
            .load({
              id: 'tsparticles-stars',
              options: {
                fpsLimit: 60,
                detectRetina: true,
                background: { color: 'transparent' },
                particles: {
                  number: { value: 650, density: { enable: false } },
                  // Mostly white, with a small fraction of pale-blue / warm-amber
                  // stars, like real stellar color classes -- avoids a flat,
                  // uniformly-white field.
                  color: {
                    value: ['#ffffff', '#ffffff', '#ffffff', '#ffffff', '#ffffff', '#ffffff', '#cfe8ff', '#ffe4b8'],
                  },
                  opacity: {
                    value: { min: 0.2, max: 1 },
                    animation: { enable: true, speed: 1, sync: false },
                  },
                  size: { value: { min: 0.5, max: 1.5 } },
                  move: {
                    enable: true,
                    speed: 0.3,
                    direction: 'top',
                    random: true,
                    straight: false,
                    outModes: { default: 'out' },
                  },
                },
              },
            })
            .then(function (container) {
              starContainer = container;
              applyDepthLayers(container);
              var theme = document.documentElement.getAttribute('data-theme') || 'dark';
              applyBackgroundTheme(theme);
            });
        });

        var observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            if (m.attributeName === 'data-theme') {
              applyBackgroundTheme(document.documentElement.getAttribute('data-theme') || 'dark');
            }
          });
        });
        observer.observe(document.documentElement, { attributes: true });
      });
    })();
  </script>
{% endif %}
